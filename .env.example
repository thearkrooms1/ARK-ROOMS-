# ==============================================================================
# The Ark ROOMS - Environment Variables Configuration
# ==============================================================================

# Supabase Configuration (Canonical Vite prefix for frontend & backend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional alias compatibility (if migrating or using Next.js / serverless aliases)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Paystack Payment Gateway
# PAYSTACK_SECRET_KEY is strictly server-side (DO NOT prefix with VITE_)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Google Maps Platform Key (Server-side geocoding; DO NOT prefix with VITE_)
GOOGLE_MAPS_PLATFORM_KEY=

# Gemini API Key (Server-side only if AI features enabled; DO NOT prefix with VITE_)
GEMINI_API_KEY=

# Hosted Application URL
APP_URL=
